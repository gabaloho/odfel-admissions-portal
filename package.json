{
  "name": "odfel-clone-tool",
  "version": "1.0.0",
  "private": true,
  "description": "ODFEL clone snapshot and admissions starter app",
  "scripts": {
    "clone:odfel": "node scripts/clone-site.js",
    "start": "node app.js",
    "dev": "node app.js",
    "clone-react:dev": "npm --prefix site-clone-react run dev",
    "clone-react:build": "npm --prefix site-clone-react run build",
    "clone-react:preview": "npm --prefix site-clone-react run preview",
    "unified:build": "npm run clone-react:build",
    "unified:start": "npm run unified:build && node app.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2"
  }
}
