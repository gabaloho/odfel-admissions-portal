# Copy this file to backend.env (next to app.js). The backend loads it on start.
# Variables already set in the real environment take precedence over this file.

PROGRAMS_JSON=[{"id":"sample-program","name":"Replace with your programme"}]

# Flat application fee (defaults to NGN 25,000 when unset).
APPLICATION_FEE_AMOUNT=25000
APPLICATION_FEE_CURRENCY=NGN
APPLICATION_FEE_DESCRIPTION=Application Processing Fee

# Printed on invoice and receipt PDFs (defaults to VITE_INSTITUTION_NAME from the frontend .env).
INSTITUTION_NAME=Your Institution

# Configure Paystack hosted checkout. Keep both values in Cloud Run Secret Manager.
PAYSTACK_SECRET_KEY=replace-with-your-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=replace-with-your-paystack-webhook-secret
# Optional during webhook-secret rotation; comma-separated previous whsec_ secrets.
# PAYSTACK_PREVIOUS_WEBHOOK_SECRETS=

# The HTTPS origin configured for the Cloud Run service and Paystack callback.
# Required in production; local development may omit it.
PUBLIC_BASE_URL=https://your-portal.example.com

# Optional legacy Flutterwave webhook secret. Do not reuse Paystack credentials.
# PAYMENT_WEBHOOK_SECRET=

# Dummy-card checkout (test mode) is ON in development and OFF when NODE_ENV=production.
# Never force it on in production: applicants could "pay" with test cards.
# MOCK_PAYMENTS_ENABLED=false

# Local default is sqlite. Production requires firestore and an explicit project ID.
# DATA_STORE=firestore
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# For local testing only, point the Admin SDK at a running Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Configure these as Cloud Run environment variables / Secret Manager references:
# NODE_ENV=production
# SESSION_SECRET=<random-secret-at-least-32-characters>
# ADMIN_USERNAME=<unique-admin-username>
# ADMIN_PASSWORD=<strong-admin-password>
# PAYSTACK_SECRET_KEY=<Paystack secret key>
# PAYSTACK_WEBHOOK_SECRET=<Paystack whsec_ signing secret>
# PUBLIC_BASE_URL=https://your-portal.example.com
