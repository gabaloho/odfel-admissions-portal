{
  "name": "odfel-admissions-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable open and distance flexible learning admissions portal",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm --prefix fedpolodfel-react run build",
    "preview": "npm --prefix fedpolodfel-react run preview",
    "backend:start": "node app.js",
    "ui:dev": "npm --prefix fedpolodfel-react run dev",
    "ui:build": "npm run build",
    "ui:preview": "npm run preview",
    "test": "node --test --test-timeout=60000 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "firebase-admin": "^14.5.1",
    "pdfkit": "^0.17.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
