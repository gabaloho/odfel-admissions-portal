{
  "name": "fedpolodfel-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Federal Polytechnic Wannune admissions portal",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "ui:dev": "npm --prefix fedpolodfel-react run dev",
    "ui:build": "npm --prefix fedpolodfel-react run build",
    "ui:preview": "npm --prefix fedpolodfel-react run preview",
    "unified:build": "npm run ui:build",
    "unified:start": "npm run unified:build && node app.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2"
  }
}
